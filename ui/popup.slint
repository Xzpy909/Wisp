// Wisp popup. One component serves all three popup styles: Beam (centre or
// at cursor) and Drawer differ only in size, position and a header row.

import { ListView, ScrollView, Switch, SpinBox, LineEdit, Button, Palette } from "std-widgets.slint";

export struct ClipRow {
    id: int,
    // Part of a multiple selection (Shift+click, Ctrl+click).
    marked: bool,
    kind: string,
    title: string,
    meta: string,
    pinned: bool,
    swatch: color,
    has-swatch: bool,
    thumb: image,
    has-thumb: bool,
}

export struct BackupRow {
    name: string,
    detail: string,
    path: string,
}

component Kbd inherits Rectangle {
    in property <string> key;
    in property <color> ink;
    in property <color> line;
    border-width: 1px;
    border-color: line;
    border-radius: 4px;
    height: 18px;
    width: label.preferred-width + 10px;
    label := Text {
        text: root.key;
        color: root.ink;
        font-size: 10.5px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component Hint inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    in property <color> ink;
    in property <color> muted;
    in property <color> line;
    spacing: 5px;
    horizontal-stretch: 0;
    VerticalLayout {
        alignment: center;
        Kbd { key: root.key; ink: root.ink; line: root.line; }
    }
    Text { text: root.label; color: root.muted; font-size: 11.5px; vertical-alignment: center; }
}

// Icon button in the style shared across the owner's apps: a bare light
// icon; on hover a rounded square appears behind it, red for close.
component FaeButton inherits Rectangle {
    in property <bool> dark;
    in property <bool> active;
    in property <string> icon: "close";
    callback clicked();
    property <bool> is-close: root.icon == "close";
    property <color> hover-bg: root.is-close ? #c42b1c : (root.dark ? #3a3a3f : #e3e3e8);
    property <color> icon-color: (root.is-close && (touch.has-hover || touch.pressed)) ? #ffffff
        : (root.dark ? #c8c8cc : #45454a);
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: touch.pressed ? root.hover-bg.darker(0.15)
        : (touch.has-hover || root.active) ? root.hover-bg
        : transparent;
    if root.is-close: Path {
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: root.icon-color;
        stroke-width: 1.3px;
        fill: transparent;
        commands: "M 0.5 0.5 L 11.5 11.5 M 11.5 0.5 L 0.5 11.5";
    }
    if root.icon == "gear": Path {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.icon-color;
        stroke-width: 1.3px;
        fill: transparent;
        commands: "M 13.14 6.72 L 14.91 6.90 L 14.91 9.10 L 13.14 9.28 L 12.54 10.73 L 13.66 12.11 L 12.11 13.66 L 10.73 12.54 L 9.28 13.14 L 9.10 14.91 L 6.90 14.91 L 6.72 13.14 L 5.27 12.54 L 3.89 13.66 L 2.34 12.11 L 3.46 10.73 L 2.86 9.28 L 1.09 9.10 L 1.09 6.90 L 2.86 6.72 L 3.46 5.27 L 2.34 3.89 L 3.89 2.34 L 5.27 3.46 L 6.72 2.86 L 6.90 1.09 L 9.10 1.09 L 9.28 2.86 L 10.73 3.46 L 12.11 2.34 L 13.66 3.89 L 12.54 5.27 Z M 10.30 8.0 A 2.3 2.3 0 1 1 5.70 8.0 A 2.3 2.3 0 1 1 10.30 8.0";
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A switch whose label wraps instead of running off a narrow window.
component SwitchRow inherits HorizontalLayout {
    in property <string> text;
    in property <color> ink;
    in-out property <bool> checked;
    callback toggled();
    spacing: 10px;
    VerticalLayout {
        alignment: start;
        Switch {
            checked <=> root.checked;
            toggled => { root.toggled(); }
        }
    }
    Text {
        text: root.text;
        color: root.ink;
        wrap: word-wrap;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

// Small glyph per clip kind.
component KindIcon inherits Rectangle {
    in property <ClipRow> clip-row;
    in property <color> muted;
    in property <color> line;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.line;
    clip: true;
    background: root.clip-row.has-swatch ? root.clip-row.swatch : transparent;
    if root.clip-row.has-thumb: Image {
        width: parent.width;
        height: parent.height;
        source: root.clip-row.thumb;
        image-fit: cover;
    }
    if !root.clip-row.has-thumb && !root.clip-row.has-swatch: Path {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.clip-row.kind == "files" ? #d9480f
            : root.clip-row.kind == "image" ? #7048e8
            : root.clip-row.kind == "code" ? #0b7285
            : root.clip-row.kind == "url" ? #2f6bff
            : root.muted;
        stroke-width: 1.4px;
        fill: transparent;
        commands: root.clip-row.kind == "files" ? "M 4 2 L 9 2 L 12 5 L 12 14 L 4 14 Z M 9 2 L 9 5 L 12 5"
            : root.clip-row.kind == "image" ? "M 2 3 L 14 3 L 14 13 L 2 13 Z M 2 11 L 6 7 L 9 10 L 11 8 L 14 11"
            : root.clip-row.kind == "code" ? "M 6 4 L 2 8 L 6 12 M 10 4 L 14 8 L 10 12"
            : root.clip-row.kind == "url" ? "M 7 9 A 3 3 0 0 0 11 9 L 13 7 A 3 3 0 0 0 9 3 L 8 4 M 9 7 A 3 3 0 0 0 5 7 L 3 9 A 3 3 0 0 0 7 13 L 8 12"
            : "M 3 4 L 13 4 M 3 8 L 13 8 M 3 12 L 9 12";
    }
}

component Section inherits Text {
    font-size: 12px;
    font-weight: 600;
}

component Segment inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <color> ink;
    in property <color> line;
    callback clicked();
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.on ? #2f6bff : root.line;
    background: root.on ? #2f6bff33 : (touch.has-hover ? #8080801a : transparent);
    Text {
        text: root.label;
        color: root.ink;
        font-size: 12px;
        font-weight: root.on ? 600 : 400;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One backup in the list, with Restore and Delete. Both ask once more
// before they act, in place.
component BackupItem inherits Rectangle {
    in property <BackupRow> backup;
    in property <color> ink;
    in property <color> muted;
    in property <color> line;
    in-out property <string> confirm-path;
    in-out property <bool> confirm-delete;
    callback restore(string);
    callback delete(string);
    property <bool> asking: root.confirm-path == root.backup.path;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.asking ? #2f6bff : root.line;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Text { text: root.backup.name; color: root.ink; font-weight: 600; wrap: word-wrap; }
        Text { text: root.backup.detail; color: root.muted; font-size: 12px; wrap: word-wrap; }
        if root.asking: Text {
            text: root.confirm-delete ? "Delete this backup file?" : "Replace all current clips with this backup?";
            color: root.ink;
            wrap: word-wrap;
        }
        if !root.asking: HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Button {
                text: "Restore";
                clicked => { root.confirm-path = root.backup.path; root.confirm-delete = false; }
            }
            Button {
                text: "Delete";
                clicked => { root.confirm-path = root.backup.path; root.confirm-delete = true; }
            }
        }
        if root.asking: HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Button {
                text: root.confirm-delete ? "Delete" : "Replace clips";
                primary: true;
                clicked => {
                    root.confirm-path = "";
                    if (root.confirm-delete) {
                        root.delete(root.backup.path);
                    } else {
                        root.restore(root.backup.path);
                    }
                }
            }
            Button { text: "Cancel"; clicked => { root.confirm-path = ""; } }
        }
    }
}

export component Popup inherits Window {
    in property <bool> drawer: false;
    in property <bool> dark: false;
    // True when Windows draws an acrylic backdrop behind the window.
    in property <bool> translucent: false;
    in property <string> hotkey-label: "Alt+V";
    in-out property <string> query: "";
    in property <[ClipRow]> clips;
    in property <string> count-label;
    in-out property <int> selected: 0;
    // How many clips are marked for a multiple selection.
    in property <int> marked-count: 0;
    // 0 = clip list, 1 = settings, 2 = backups.
    in-out property <int> page: 0;
    // Type filter, cycled with Tab; same order as `Filter::ALL` in Rust.
    in-out property <int> filter: 0;
    property <[string]> filter-names: ["All", "Text", "Links", "Images", "Files", "Colours", "Code", "Pinned"];
    property <[string]> filter-empty: ["", "No text yet", "No links yet", "No images yet", "No files yet", "No colours yet", "No code yet", "Nothing pinned yet"];

    // Settings, shown on the settings page.
    in-out property <int> style-index: 0;
    in-out property <bool> glass: false;
    in-out property <bool> autostart: true;
    in-out property <bool> capture-images: true;
    in-out property <bool> capture-files: true;
    in-out property <int> keep-days: 30;
    in-out property <int> max-clips: 5000;
    in-out property <string> hotkey-text: "Alt+V";
    in property <string> hotkey-error;
    in property <string> version: "0.1.0";

    callback dismiss();
    callback query-edited(string);
    callback settings-changed();
    callback glass-toggled();
    callback apply-hotkey(string);
    callback clear-history();
    callback open-data-folder();

    // Backups page.
    in property <[BackupRow]> backups;
    in property <[BackupRow]> snapshots;
    in-out property <string> backup-name;
    in property <string> backup-status;
    in property <bool> backup-error;
    // The backup a Restore or Delete click waits to have confirmed.
    in-out property <string> confirm-path;
    in-out property <bool> confirm-delete;
    callback open-backups();
    callback create-backup(string);
    callback restore-backup(string);
    callback delete-backup(string);
    callback open-backups-folder();
    // Clip actions, by clip id.
    callback paste(int, bool);
    callback toggle-pin(int);
    callback forget(int);
    callback reveal(int);
    callback filter-changed();
    // A row was clicked or reached with the arrows; Rust keeps the marks.
    callback row-pressed(int, bool, bool);

    public function focus-search() {
        search.focus();
    }

    // Standard widgets (switches, fields, buttons) follow the popup's theme.
    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <length> row-height: root.drawer ? 48px : 40px;
    property <color> ink: root.dark ? #ececf0 : #141416;
    property <color> muted: root.dark ? #a2a4ad : #5d5f66;
    property <color> line: root.dark ? #ffffff1a : #00000017;
    property <color> accent: #2f6bff;
    property <color> sel: root.dark ? #5082ff38 : #2f6bff1f;
    property <color> panel: root.dark ? #202024 : #f9f9fb;

    function go-back() {
        root.confirm-path = "";
        if (root.page == 2) {
            root.page = 1;
        } else {
            root.page = 0;
            search.focus();
        }
    }

    function set-filter(f: int) {
        root.filter = Math.mod(f + root.filter-names.length, root.filter-names.length);
        root.selected = 0;
        list.content-y = 0;
        root.filter-changed();
    }

    function selected-id() -> int {
        return root.clips.length > root.selected ? root.clips[root.selected].id : -1;
    }

    function move(delta: int, extend: bool) {
        if (root.clips.length == 0) {
            return;
        }
        root.selected = Math.max(0, Math.min(root.clips.length - 1, root.selected + delta));
        root.scroll-to-selected();
        root.row-pressed(root.selected, extend, false);
    }

    // Keep the selected row in view.
    public function scroll-to-selected() {
        if (root.selected * root.row-height + list.content-y < 0) {
            list.content-y = -root.selected * root.row-height;
        }
        if ((root.selected + 1) * root.row-height + list.content-y > list.visible-height) {
            list.content-y = list.visible-height - (root.selected + 1) * root.row-height;
        }
    }

    title: "Wisp";
    no-frame: true;
    always-on-top: true;
    background: root.translucent ? transparent : root.panel;
    default-font-size: 13px;
    forward-focus: search;

    FocusScope {
        // Clip shortcuts are caught before the search field sees them.
        capture-key-pressed(event) => {
            if (root.page != 0) {
                return reject;
            }
            if (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                root.move(event.text == Key.DownArrow ? 1 : -1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.Return || event.text == "\u{d}") {
                if (root.selected-id() >= 0) {
                    root.paste(root.selected-id(), event.modifiers.shift);
                }
                return accept;
            }
            if (event.text == Key.Tab && !event.modifiers.control) {
                root.set-filter(root.filter + (event.modifiers.shift ? -1 : 1));
                return accept;
            }
            if (event.text == Key.Backtab) {
                root.set-filter(root.filter - 1);
                return accept;
            }
            if (event.modifiers.control && !event.modifiers.alt) {
                if (event.text == "p" || event.text == "P") {
                    if (root.selected-id() >= 0) {
                        root.toggle-pin(root.selected-id());
                    }
                    return accept;
                }
                if (event.text == Key.Delete) {
                    if (root.selected-id() >= 0) {
                        root.forget(root.selected-id());
                    }
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    if (root.selected-id() >= 0) {
                        root.reveal(root.selected-id());
                    }
                    return accept;
                }
            }
            reject
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.page != 0) {
                    root.go-back();
                } else if (root.marked-count > 1) {
                    root.row-pressed(root.selected, false, false);
                } else if (root.query != "") {
                    root.query = "";
                    root.query-edited("");
                } else if (root.filter != 0) {
                    root.set-filter(0);
                } else {
                    root.dismiss();
                }
                return accept;
            }
            reject
        }

        Rectangle {
            // A light tint over the acrylic keeps text contrast high.
            background: root.translucent ? root.panel.with-alpha(0.55) : transparent;
            border-width: 1px;
            border-color: root.line;
            border-radius: 8px;

            VerticalLayout {
                if root.drawer: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 10px;
                    height: 36px;
                    spacing: 8px;
                    Text { text: "Wisp"; font-weight: 600; color: root.ink; vertical-alignment: center; }
                    Text {
                        text: root.hotkey-label;
                        color: root.muted;
                        font-size: 11.5px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        FaeButton {
                            icon: "gear";
                            dark: root.dark;
                            active: root.page != 0;
                            clicked => { root.page = root.page != 0 ? 0 : 1; root.confirm-path = ""; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        FaeButton { icon: "close"; dark: root.dark; clicked => { root.dismiss(); } }
                    }
                }

                HorizontalLayout {
                    height: root.drawer ? 44px : 56px;
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        // Magnifier on the list; a back arrow on the settings page.
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            x: -6px;
                            border-radius: 6px;
                            background: root.page != 0 && back.has-hover ? (root.dark ? #3a3a3f : #e3e3e8) : transparent;
                            Path {
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                viewbox-width: 16;
                                viewbox-height: 16;
                                stroke: root.page != 0 ? root.ink : root.muted;
                                stroke-width: 1.5px;
                                fill: transparent;
                                commands: root.page != 0
                                    ? "M 10 3 L 5 8 L 10 13"
                                    : "M 10.5 10.5 L 14.5 14.5 M 11.5 6.5 A 5 5 0 1 1 1.5 6.5 A 5 5 0 1 1 11.5 6.5";
                            }
                            back := TouchArea {
                                enabled: root.page != 0;
                                mouse-cursor: root.page != 0 ? pointer : default;
                                clicked => { root.go-back(); }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        search := TextInput {
                            visible: root.page == 0;
                            width: 100%;
                            height: 100%;
                            text <=> root.query;
                            single-line: true;
                            font-size: root.drawer ? 14px : 18px;
                            color: root.ink;
                            vertical-alignment: center;
                            selection-background-color: root.accent.with-alpha(0.35);
                            edited => {
                                root.selected = 0;
                                list.content-y = 0;
                                root.query-edited(self.text);
                            }
                        }
                        Text {
                            visible: root.page != 0 || root.query == "";
                            width: 100%;
                            height: 100%;
                            text: root.page == 1 ? "Settings"
                                : root.page == 2 ? "Backups"
                                : root.filter == 0 ? "Search clipboard history"
                                : "Search " + root.filter-names[root.filter].to-lowercase();
                            font-size: root.drawer ? 14px : 18px;
                            font-weight: root.page != 0 ? 600 : 400;
                            color: root.page != 0 ? root.ink : root.muted;
                            vertical-alignment: center;
                        }
                    }
                    // The active type filter; click to show everything again.
                    if root.page == 0 && root.filter != 0: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            width: pill-text.preferred-width + 38px;
                            border-radius: 12px;
                            background: pill.has-hover ? root.accent.with-alpha(0.32) : root.accent.with-alpha(0.2);
                            pill-text := Text {
                                x: 10px;
                                text: root.filter-names[root.filter];
                                color: root.ink;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Path {
                                x: parent.width - 20px;
                                width: 8px;
                                height: 8px;
                                y: (parent.height - self.height) / 2;
                                viewbox-width: 8;
                                viewbox-height: 8;
                                stroke: root.ink;
                                stroke-width: 1.2px;
                                commands: "M 0.5 0.5 L 7.5 7.5 M 7.5 0.5 L 0.5 7.5";
                            }
                            pill := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.set-filter(0); search.focus(); }
                            }
                        }
                    }
                    if !root.drawer: VerticalLayout {
                        alignment: center;
                        FaeButton {
                            icon: "gear";
                            dark: root.dark;
                            active: root.page != 0;
                            clicked => { root.page = root.page != 0 ? 0 : 1; root.confirm-path = ""; }
                        }
                    }
                    if !root.drawer: VerticalLayout {
                        alignment: center;
                        FaeButton { icon: "close"; dark: root.dark; clicked => { root.dismiss(); } }
                    }
                }

                Rectangle { height: 1px; background: root.line; }

                // Clip list.
                // Clip list and settings share this space; one shows at a time.
                Rectangle {
                    vertical-stretch: 1;
                    list := ListView {
                        width: 100%;
                        height: 100%;
                        visible: root.page == 0;
                        for row[i] in root.clips: Rectangle {
                            height: root.row-height;
                            Rectangle {
                                x: 4px;
                                width: parent.width - 8px;
                                border-radius: 6px;
                                background: i == root.selected || row.marked ? root.sel : (hover.has-hover ? #8080800f : transparent);
                                Rectangle {
                                    visible: i == root.selected;
                                    x: 0;
                                    y: 9px;
                                    width: 3px;
                                    height: parent.height - 18px;
                                    border-radius: 2px;
                                    background: root.accent;
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        KindIcon { clip-row: row; muted: root.muted; line: root.line; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text {
                                            text: row.title;
                                            color: root.ink;
                                            overflow: elide;
                                            font-family: row.kind == "code" ? "Consolas" : "";
                                        }
                                        if root.drawer: Text {
                                            text: row.meta;
                                            color: root.muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                    if !root.drawer: Text {
                                        text: row.meta;
                                        color: root.muted;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                }
                                ContextMenuArea {
                                    width: 100%;
                                    height: 100%;
                                    hover := TouchArea {
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                root.row-pressed(i, e.modifiers.shift, e.modifiers.control);
                                                search.focus();
                                            }
                                        }
                                        double-clicked => { root.paste(row.id, false); }
                                    }
                                    Menu {
                                        MenuItem {
                                            title: row.marked && root.marked-count > 1 ? "Paste " + root.marked-count + " clips" : "Paste";
                                            activated => { root.paste(row.id, false); }
                                        }
                                        MenuItem {
                                            title: "Paste as plain text";
                                            activated => { root.paste(row.id, true); }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: row.pinned ? "Unpin" : "Pin";
                                            activated => { root.toggle-pin(row.id); }
                                        }
                                        MenuItem {
                                            title: "Show in File Explorer";
                                            enabled: row.kind == "files" || row.kind == "image";
                                            activated => { root.reveal(row.id); }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: row.marked && root.marked-count > 1 ? "Forget " + root.marked-count + " clips" : "Forget";
                                            activated => { root.forget(row.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.page == 0 && root.clips.length == 0: VerticalLayout {
                        width: 100%;
                        height: 100%;
                        alignment: center;
                        padding: 24px;
                        spacing: 6px;
                        Text {
                            text: root.query != "" ? "No clips match \"" + root.query + "\""
                                : root.filter != 0 ? root.filter-empty[root.filter]
                                : "No clips yet";
                            color: root.ink;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.query != "" ? "Try fewer letters, or press Esc to clear."
                                : root.filter != 0 ? "Press Tab for another type, or Esc to show all."
                                : "Copy some text, a file or an image and it shows up here.";
                            color: root.muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    // Settings page. Labels sit above their controls so the
                    // page also fits the narrow Drawer at any scale.
                    if root.page == 1: sv := ScrollView {
                        width: 100%;
                        height: 100%;
                        VerticalLayout {
                            width: sv.visible-width;
                            alignment: start;
                            padding: 16px;
                            padding-top: 12px;
                            spacing: 10px;

                            Section { text: "Popup"; color: root.ink; }
                            if !root.drawer: HorizontalLayout {
                                spacing: 6px;
                                Segment {
                                    label: "Beam, centre";
                                    on: root.style-index == 0;
                                    ink: root.ink;
                                    line: root.line;
                                    clicked => { root.style-index = 0; root.settings-changed(); }
                                }
                                Segment {
                                    label: "Beam, at cursor";
                                    on: root.style-index == 1;
                                    ink: root.ink;
                                    line: root.line;
                                    clicked => { root.style-index = 1; root.settings-changed(); }
                                }
                                Segment {
                                    label: "Drawer";
                                    on: root.style-index == 2;
                                    ink: root.ink;
                                    line: root.line;
                                    clicked => { root.style-index = 2; root.settings-changed(); }
                                }
                            }
                            if root.drawer: VerticalLayout {
                                spacing: 6px;
                                Segment {
                                    label: "Beam, centre";
                                    on: root.style-index == 0;
                                    ink: root.ink;
                                    line: root.line;
                                    clicked => { root.style-index = 0; root.settings-changed(); }
                                }
                                Segment {
                                    label: "Beam, at cursor";
                                    on: root.style-index == 1;
                                    ink: root.ink;
                                    line: root.line;
                                    clicked => { root.style-index = 1; root.settings-changed(); }
                                }
                                Segment {
                                    label: "Drawer";
                                    on: root.style-index == 2;
                                    ink: root.ink;
                                    line: root.line;
                                    clicked => { root.style-index = 2; root.settings-changed(); }
                                }
                            }
                            SwitchRow {
                                text: "Glass effect (uses about 35 MB more memory, restarts Wisp)";
                                ink: root.ink;
                                checked <=> root.glass;
                                toggled => { root.glass-toggled(); }
                            }
                            Text { text: "Shortcut"; color: root.ink; }
                            HorizontalLayout {
                                spacing: 8px;
                                hk := LineEdit {
                                    text <=> root.hotkey-text;
                                    placeholder-text: "Alt+V";
                                    horizontal-stretch: 1;
                                    accepted(t) => { root.apply-hotkey(t); }
                                }
                                Button { text: "Apply"; clicked => { root.apply-hotkey(hk.text); } }
                            }
                            if root.hotkey-error != "": Text {
                                text: root.hotkey-error;
                                color: #e0577f;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 1px; background: root.line; }
                            Section { text: "History"; color: root.ink; }
                            Text { text: "Keep clips for (days, 0 = forever)"; color: root.ink; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: start;
                                SpinBox {
                                    width: 150px;
                                    minimum: 0;
                                    maximum: 3650;
                                    value <=> root.keep-days;
                                    edited => { root.settings-changed(); }
                                }
                            }
                            Text { text: "Keep at most (clips, 0 = no limit)"; color: root.ink; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: start;
                                SpinBox {
                                    width: 150px;
                                    minimum: 0;
                                    maximum: 100000;
                                    step-size: 500;
                                    value <=> root.max-clips;
                                    edited => { root.settings-changed(); }
                                }
                            }
                            Text { text: "Pinned clips are always kept."; color: root.muted; font-size: 12px; wrap: word-wrap; }
                            SwitchRow {
                                text: "Record copied images";
                                ink: root.ink;
                                checked <=> root.capture-images;
                                toggled => { root.settings-changed(); }
                            }
                            SwitchRow {
                                text: "Record copied files and folders";
                                ink: root.ink;
                                checked <=> root.capture-files;
                                toggled => { root.settings-changed(); }
                            }
                            if !root.drawer: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Button { text: "Clear history (keeps pinned)"; clicked => { root.clear-history(); } }
                                Button { text: "Open data folder"; clicked => { root.open-data-folder(); } }
                            }
                            if root.drawer: VerticalLayout {
                                spacing: 8px;
                                Button { text: "Clear history (keeps pinned)"; clicked => { root.clear-history(); } }
                                Button { text: "Open data folder"; clicked => { root.open-data-folder(); } }
                            }

                            Rectangle { height: 1px; background: root.line; }
                            Section { text: "Backups"; color: root.ink; }
                            Text {
                                text: "Save all clips under a name and bring them back later, for example a set of text snippets for one project.";
                                color: root.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button { text: "Backup and restore…"; clicked => { root.open-backups(); } }
                            }

                            Rectangle { height: 1px; background: root.line; }
                            Section { text: "Keys"; color: root.ink; }
                            for k in [
                                { key: "Enter", what: "Paste into the app you were in" },
                                { key: "Shift+Enter", what: "Paste as plain text (files as their paths)" },
                                { key: "Shift+click, Ctrl+click", what: "Select several clips (also Shift+↑↓); Enter pastes them together" },
                                { key: "Right-click", what: "Paste, pin or unpin, show in File Explorer, forget" },
                                { key: "Tab, Shift+Tab", what: "Show only text, links, images, files, colours, code or pinned" },
                                { key: "Ctrl+P", what: "Pin or unpin. Pinned clips stay on top and are never removed" },
                                { key: "Ctrl+Delete", what: "Forget the clip" },
                                { key: "Ctrl+O", what: "Show a file or image clip in File Explorer" },
                                { key: "Esc", what: "Clear the search, then the filter, then close" },
                            ]: HorizontalLayout {
                                spacing: 10px;
                                Text { text: k.key; color: root.ink; font-weight: 600; width: root.drawer ? 92px : 110px; wrap: word-wrap; }
                                Text { text: k.what; color: root.muted; wrap: word-wrap; horizontal-stretch: 1; }
                            }

                            Rectangle { height: 1px; background: root.line; }
                            Section { text: "System"; color: root.ink; }
                            SwitchRow {
                                text: "Start with Windows";
                                ink: root.ink;
                                checked <=> root.autostart;
                                toggled => { root.settings-changed(); }
                            }
                            Text {
                                text: "Wisp " + root.version + " · Made with Slint";
                                color: root.muted;
                                font-size: 11.5px;
                            }
                        }
                    }
                    // Backups page.
                    if root.page == 2: bsv := ScrollView {
                        width: 100%;
                        height: 100%;
                        VerticalLayout {
                            width: bsv.visible-width;
                            alignment: start;
                            padding: 16px;
                            padding-top: 12px;
                            spacing: 10px;

                            Section { text: "New backup"; color: root.ink; }
                            Text {
                                text: "Saves every clip, pinned ones and images included. A backup with the same name is replaced.";
                                color: root.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                name-edit := LineEdit {
                                    text <=> root.backup-name;
                                    placeholder-text: "Name, e.g. Starfall launch";
                                    horizontal-stretch: 1;
                                    accepted(t) => { root.create-backup(t); }
                                }
                                Button { text: "Back up"; clicked => { root.create-backup(name-edit.text); } }
                            }
                            if root.backup-status != "": Text {
                                text: root.backup-status;
                                color: root.backup-error ? #e0577f : root.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 1px; background: root.line; }
                            Section { text: "Restore"; color: root.ink; }
                            Text {
                                text: "Restoring replaces all current clips, pinned ones too. Wisp saves a safety snapshot of them first.";
                                color: root.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            if root.backups.length == 0: Text {
                                text: "No backups yet.";
                                color: root.muted;
                            }
                            for b in root.backups: BackupItem {
                                backup: b;
                                ink: root.ink;
                                muted: root.muted;
                                line: root.line;
                                confirm-path <=> root.confirm-path;
                                confirm-delete <=> root.confirm-delete;
                                restore(p) => { root.restore-backup(p); }
                                delete(p) => { root.delete-backup(p); }
                            }

                            Rectangle { height: 1px; background: root.line; }
                            Section { text: "Safety snapshots"; color: root.ink; }
                            Text {
                                text: "Your clips as they were before each restore. The newest 5 are kept.";
                                color: root.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            if root.snapshots.length == 0: Text {
                                text: "None yet.";
                                color: root.muted;
                            }
                            for b in root.snapshots: BackupItem {
                                backup: b;
                                ink: root.ink;
                                muted: root.muted;
                                line: root.line;
                                confirm-path <=> root.confirm-path;
                                confirm-delete <=> root.confirm-delete;
                                restore(p) => { root.restore-backup(p); }
                                delete(p) => { root.delete-backup(p); }
                            }

                            Rectangle { height: 1px; background: root.line; }
                            HorizontalLayout {
                                alignment: start;
                                Button { text: "Open backups folder"; clicked => { root.open-backups-folder(); } }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: root.line; }

                HorizontalLayout {
                    height: 32px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 14px;
                    if root.page == 0: Hint { key: "↵"; label: "Paste"; ink: root.ink; muted: root.muted; line: root.line; }
                    if root.page == 0: Hint { key: "Tab"; label: "Filter"; ink: root.ink; muted: root.muted; line: root.line; }
                    if root.page == 0 && !root.drawer: Hint { key: "Ctrl+P"; label: "Pin"; ink: root.ink; muted: root.muted; line: root.line; }
                    if root.page == 0 && !root.drawer: Hint { key: "Ctrl+Del"; label: "Forget"; ink: root.ink; muted: root.muted; line: root.line; }
                    if root.page == 0 && root.drawer: Hint { key: "Esc"; label: "Close"; ink: root.ink; muted: root.muted; line: root.line; }
                    if root.page == 1: Hint { key: "Esc"; label: "Back to clips"; ink: root.ink; muted: root.muted; line: root.line; }
                    if root.page == 2: Hint { key: "Esc"; label: "Back to settings"; ink: root.ink; muted: root.muted; line: root.line; }
                    Text {
                        horizontal-stretch: 1;
                        text: root.page != 0 ? ""
                            : root.marked-count > 1 ? root.marked-count + " selected · " + root.count-label
                            : root.count-label;
                        color: root.muted;
                        font-size: 11.5px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
